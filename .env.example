# Администратор (единственный, управляется только отсюда)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# Telegram: токен бота от @BotFather и id чата для напоминаний
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Кнопка «✅ Оплачено» в напоминании. Нажимать могут участники чата, куда бот шлёт напоминания.
# Чтобы Telegram разрешил боту проверять участников, сделайте бота администратором чата.
TELEGRAM_BUTTONS_ENABLED=true
# Необязательно: сузить круг до перечисленных Telegram id (через запятую), например 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# MAX: то же, что Telegram. Токен бота из «MAX для бизнеса» (business.max.ru, раздел «Чат-боты») и id чата.
# Бота добавьте в групповой чат администратором (иначе MAX не присылает ему нажатия кнопок).
# id чата: docker compose exec app python -m app.services.max_api (после того как бота добавили и в чате написали сообщение)
MAX_BOT_TOKEN=
MAX_CHAT_ID=
# Кнопка «✅ Оплачено» в напоминании MAX, нажимать могут участники чата
MAX_BUTTONS_ENABLED=true
# Необязательно: сузить круг до перечисленных id пользователей MAX (через запятую)
MAX_ALLOWED_USER_IDS=

# Email: напоминания по почте через SMTP. Включается, когда заданы хост, отправитель и получатели.
# Яндекс: smtp.yandex.ru, порт 465, SMTP_SECURITY=ssl, логин и пароль приложения ящика.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Получатели через запятую
SMTP_TO=
# Адрес панели для ссылки в письме, например https://keeper.example.com
PUBLIC_URL=

# Webhook: напоминания (событие reminder.due) и события журнала уходят POST-запросом с JSON.
# Поля text и content подходят для входящих webhook Slack, Mattermost и Discord.
WEBHOOK_URL=
# Необязательно: секрет для подписи, заголовок X-Invoice-Keeper-Signature: sha256=<HMAC тела>
WEBHOOK_SECRET=
# Какие события журнала отправлять: имена или группы с точкой
WEBHOOK_EVENTS=payment.,occurrence.,receipt.,user.

# Чеки: лимит размера файла в МБ и число вложений на один период
RECEIPT_MAX_MB=5
RECEIPTS_PER_PERIOD=10

# Единый часовой пояс для расчёта «сегодня»
APP_TIMEZONE=Europe/Moscow

# За сколько дней до срока напоминать
REMINDER_DAYS=3

# Фоновая проверка сроков: включена ли и как часто (секунды)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Срок жизни сессии в часах и флаг Secure для cookie (включить за HTTPS)
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Защита входа: после стольких неудачных попыток с одного адреса логин закрывается на столько минут
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Порт панели на хосте при запуске через Docker (по умолчанию 8000)
# APP_PORT=8000

# База данных в Docker лежит в volume и задаётся в docker-compose.yml, здесь её менять не нужно.
# Для запуска без Docker по умолчанию используется ./data/invoice_keeper.db

# Тестовые данные при первом запуске (аренда RUB, сервер USD, подписка EUR) и демо-пользователь
SEED_DEMO_DATA=true
SEED_USER_LOGIN=user
SEED_USER_PASSWORD=user-pass-123
